#!/usr/bin/env bash
# Sum known worker cost. Rows with null or omitted costUsd are blind, not $0.
source "$(dirname "$0")/../lib/common.sh"
source "$(dirname "$0")/../lib/usage-report.sh"

usage() {
  echo 'Usage: bin/usage [--since YYYY-MM-DD] [--until YYYY-MM-DD] [--file PATH]'
  echo '  Sums numeric costUsd only. Null or omitted cost is listed as blind, not added as $0.'
  echo '  Dates are inclusive UTC dates on recordedAt. Default file: state/usage.jsonl.'
}
[[ ${1:-} != --help ]] || { usage; exit 0; }

since=; until=; file=
while [[ $# -gt 0 ]]; do
  case $1 in
    --since|--until|--file)
      [[ $# -ge 2 ]] || die "Missing value for $1"
      case $1 in
        --since) since=$2;;
        --until) until=$2;;
        --file) file=$2;;
      esac
      shift 2;;
    *) usage >&2; die "Unknown argument: $1";;
  esac
done
[[ -z $since || $since =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die '--since must be YYYY-MM-DD.'
[[ -z $until || $until =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die '--until must be YYYY-MM-DD.'
require_runtime
if [[ -z $file ]]; then
  file=$STATE/usage.jsonl
  if [[ ! -f $file ]]; then
    echo 'records: 0'
    echo 'window: none'
    echo 'known_usd: 0.00'
    echo 'priced: 0'
    echo 'blind: 0'
    exit 0
  fi
fi
[[ -f $file && ! -L $file ]] || die "Usage log is not a regular file: $file"
usage_report "$file" "$since" "$until" full

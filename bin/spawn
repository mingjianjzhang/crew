#!/usr/bin/env bash
source "$(dirname "$0")/../lib/common.sh"
usage() {
  echo 'Usage: bin/spawn --id ID --project PATH --kind ship|scout --brief FILE [--profile default|planning|routine|mechanics|new-feature]'
  echo '       [--agent KIND] [--model MODEL] [--effort LEVEL|default] [--base REF] [--share ID|none]'
  echo '       [--unattended-bypass]'
  echo '       bin/spawn --resume ID'
}
[[ ${1:-} != --help ]] || { usage; exit 0; }
require_runtime
resume=; id=; project=; kind=; harness=; brief=; bypass=false; profile=; model=; effort=; base_arg=; share_arg=; playtest_dir=
while [[ $# -gt 0 ]]; do
  case $1 in
    --unattended-bypass) bypass=true; shift;;
    --id|--project|--kind|--agent|--brief|--resume|--profile|--model|--effort|--base|--share)
      [[ $# -ge 2 ]] || die "Missing value for $1"
      case $1 in
        --id) id=$2;; --project) project=$2;; --kind) kind=$2;;
        --profile) profile=$2;; --model) model=$2;; --effort) effort=$2;;
        --agent) harness=$2;; --brief) brief=$2;; --resume) resume=$2;;
        --base) base_arg=$2;; --share) share_arg=$2;;
      esac; shift 2;;
    *) usage >&2; die "Unknown argument: $1";;
  esac
done
if [[ -n $resume ]]; then
  [[ -z $id$project$kind$harness$brief$profile$model$effort$base_arg$share_arg && $bypass == false ]] || die '--resume cannot be combined with spawn options.'
  valid_id "$resume"; lock "$STATE/$resume.lock"; load_task "$resume"
else
  valid_id "$id"
  # Profiles choose defaults; an explicit harness alone preserves the existing native route.
  if [[ -z $profile && -n $harness ]]; then
    profile=custom
  else
    profile=${profile:-default}
    preset=$(awk -F '\t' -v profile="$profile" '$1 == profile {print}' "$CREW_ROOT/profiles.tsv")
    [[ -n $preset && $preset != *$'\n'* ]] || die "Unknown or duplicate worker profile: $profile"
    preset_harness=$(cut -f2 <<< "$preset")
    [[ -z $harness || $harness == "$preset_harness" ]] || die "Profile $profile requires $preset_harness. For a custom route, omit --profile and specify --agent and --model."
    harness=$preset_harness
    model=${model:-$(cut -f3 <<< "$preset")}
    effort=${effort:-$(cut -f4 <<< "$preset")}
  fi
  [[ $effort != default && $effort != - ]] || effort=
  [[ -z $effort || $effort =~ ^[a-z][a-z0-9-]*$ ]] || die 'Invalid effort level.'
  [[ $kind == ship || $kind == scout ]] || die '--kind must be ship or scout.'
  [[ -n $project && -n $harness && -f $brief && -s $brief ]] || die 'Project, agent kind and a nonempty brief file are required.'
  [[ -z $base_arg || $base_arg != *[$'\n\r\t']* ]] || die 'Base ref cannot contain control characters.'
  project=$(cd "$project" && git rev-parse --show-toplevel)
  project=$(cd "$project" && pwd -P)
  [[ $project != *[$'\n\r\t']* ]] || die 'Project path cannot contain control characters.'
  lock "$STATE/$id.lock"
  [[ ! -e $STATE/$id.meta && ! -e $CREW_ROOT/data/$id ]] || die "Task id already used: $id"
  row=$(awk -F '\t' -v kind="$harness" '$1 == kind {print}' "$CREW_ROOT/harnesses.tsv")
  [[ -n $row && $row != *$'\n'* ]] || die "Unsupported or duplicate harness: $harness"
  policy=$(cut -f2 <<< "$row"); args=$(cut -f3 <<< "$row")
  [[ $policy == guarded || $policy == bypass ]] || die 'Invalid harness permission policy.'
  [[ $policy != bypass || $bypass == true ]] || die "$harness has no approval sandbox. Pass --unattended-bypass only if you accept that."
  jq -e 'type == "array" and all(.[]; type == "string" and all(explode[]; . >= 32 and . != 127))' <<< "$args" >/dev/null || die 'Invalid harness arguments.'
  launch_args=$args
  if [[ -n $model ]]; then
    template=$(cut -f4 <<< "$row")
    launch_args=$(jq -cn --argjson args "$launch_args" --argjson template "$template" --arg model "$model" \
      '$args + ($template | map(split("{model}") | join($model)))')
  fi
  if [[ -n $effort ]]; then
    template=$(cut -f5 <<< "$row")
    launch_args=$(jq -cn --argjson args "$launch_args" --argjson template "$template" --arg effort "$effort" \
      '$args + ($template | map(split("{effort}") | join($effort)))')
  fi
  jq -e 'type == "array" and all(.[]; type == "string" and all(explode[]; . >= 32 and . != 127))' <<< "$launch_args" >/dev/null || die 'Invalid model launch arguments.'
  command -v "$harness" >/dev/null || die "Worker CLI is not installed: $harness"
  integrations=$(herdr integration status)
  awk -v kind="$harness:" '$1 == kind && $2 == "current" {found=1} END {exit !found}' <<< "$integrations" ||
    die "Integration missing or outdated. Human setup: herdr integration install $harness"
  git -C "$project" show-ref --verify --quiet "refs/heads/crew/$id" && die 'Worker branch already exists.'
  git -C "$project" fetch origin
  default=$(git -C "$project" ls-remote --symref origin HEAD | awk '$1=="ref:" && $3=="HEAD" {sub("refs/heads/", "", $2); print $2}')
  [[ -n $default ]] || die 'Cannot discover origin default branch.'
  if [[ -n $base_arg ]]; then
    # Prefer a remote-tracking ref so stacked feature branches stay shared.
    if [[ $base_arg == origin/* ]]; then
      base=$base_arg
    elif git -C "$project" rev-parse --verify "origin/$base_arg^{commit}" >/dev/null 2>&1; then
      base=origin/$base_arg
    else
      base=$base_arg
    fi
  else
    base=origin/$default
  fi
  git -C "$project" rev-parse --verify "$base^{commit}" >/dev/null || die "Unknown base ref: $base"
  if git -C "$project" cat-file -e "$base:.crew" 2>/dev/null; then die 'Project already tracks .crew; refusing to overwrite it.'; fi
  # Branch name workers should open PRs against (default branch, or the stacked feature branch).
  if [[ $base == origin/* ]]; then
    pr_base=${base#origin/}
  elif [[ $base == refs/heads/* ]]; then
    pr_base=${base#refs/heads/}
  else
    pr_base=$default
  fi
  # Shared board: explicit --share, or auto from non-default PR base; --share none disables.
  share=
  if [[ $share_arg == none ]]; then
    share=
  elif [[ -n $share_arg ]]; then
    [[ $share_arg =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || die 'Invalid --share id.'
    share=$share_arg
  elif [[ $pr_base != "$default" ]]; then
    share=${pr_base//\//-}
    [[ $share =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || die "Cannot derive share id from base: $pr_base"
  fi
  # Persist ownership before calling herdr. The critical section never launches an agent.
  lock "$STATE/.allocation.lock"
  shopt -s nullglob
  metas=("$STATE"/*.meta)
  used='[]'
  if [[ ${#metas[@]} -gt 0 ]]; then
    used=$(jq -se 'if all(.[]; .port_base | type == "number") then map(.port_base) else error("Invalid port reservation") end' "${metas[@]}")
  fi
  port=5100
  while jq -e --argjson port "$port" 'index($port) != null' <<< "$used" >/dev/null; do port=$((port+10)); done
  [[ $port -le 65520 ]] || die 'No port blocks available.'
  mkdir -p "$STATE/worktrees"
  intended=$STATE/worktrees/$id
  [[ ! -e $intended ]] || die "Worktree path already exists: $intended"
  cp "$brief" "$STATE/$id.brief.md"
  if [[ $pr_base != "$default" ]]; then
    printf '\n## Stacked delivery\n\nBase this work on `%s`. Open the GitHub PR against `%s`, not `%s`. Do not merge into `%s`.\n' \
      "$base" "$pr_base" "$default" "$default" >> "$STATE/$id.brief.md"
  fi
  if [[ -n $share ]]; then
    playtest_dir=$STATE/playtest/$share
    mkdir -p "$playtest_dir"
    printf '\n## Shared board\n\nSibling workers on this stack share `.crew/share` (Crew home `state/share/%s`). Read it for landed notes and reviews. Write short updates there when you land something others need. Do not wait or poll siblings.\n' \
      "$share" >> "$STATE/$id.brief.md"
    printf '\n## Shared playtest root\n\nThis task sets `PLAYTEST_DIR=%s`. Community servers, scenarios, recording tools, and digests must honor this absolute path. Read packets at this source-of-truth path; do not copy them into the worktree.\n' \
      "$playtest_dir" >> "$STATE/$id.brief.md"
  fi
  jq -n --arg id "$id" --arg project "$project" --arg kind "$kind" --arg harness "$harness" \
    --arg path "$intended" --arg base "$base" --arg pr_base "$pr_base" --arg share "$share" \
    --argjson args "$args" --argjson port "$port" \
    --arg profile "$profile" --arg model "$model" --arg effort "$effort" --argjson launch_args "$launch_args" \
    --argjson started "$(date +%s)" '{id:$id,project:$project,kind:$kind,harness:$harness,
      worktree:$path,branch:("crew/"+$id),agent:("crew-"+$id),base:$base,pr_base:$pr_base,
      share:(if $share=="" then null else $share end),
      profile:$profile,model:(if $model=="" then null else $model end),
      effort:(if $effort=="" then null else $effort end),launch_args:$launch_args,
      permission_args:$args,port_base:$port,started:$started,phase:"reserved"}' > "$STATE/$id.meta.tmp"
  mv "$STATE/$id.meta.tmp" "$STATE/$id.meta"
  unlock "$STATE/.allocation.lock"
  load_task "$id"
fi

if [[ $PHASE == dispatched ]]; then echo "$ID already dispatched; no prompt sent."; exit 0; fi
if [[ $PHASE == dispatching ]]; then
  die 'Initial prompt delivery is uncertain. Inspect the pane and status log; Crew will not automatically repeat it.'
fi
[[ $PHASE != removing && $PHASE != removed ]] || die 'Teardown is in progress.'
if [[ $PHASE == reserved || $PHASE == creating ]]; then
  phase creating
  response=$STATE/$ID.create.json
  if [[ -d $WORKTREE ]]; then
    # Recovery after create succeeded but metadata was not updated. Read returned IDs afresh.
    verify_worktree
    herdr worktree open --cwd "$PROJECT" --path "$WORKTREE" --label "$AGENT" --no-focus > "$response"
  else
    herdr worktree create --cwd "$PROJECT" --path "$WORKTREE" --branch "$BRANCH" \
      --base "$(jq -r .base "$META")" --label "$AGENT" --no-focus > "$response"
  fi
  actual=$(jq -er '.result.worktree.path' "$response")
  [[ $(cd "$actual" && pwd -P) == "$WORKTREE" ]] || die 'herdr returned an unexpected worktree path; inspect the creation response.'
  WORKSPACE=$(jq -er '.result.workspace.workspace_id' "$response")
  PANE=$(jq -er '.result.root_pane.pane_id' "$response")
  meta_update --arg ws "$WORKSPACE" --arg pane "$PANE" '.workspace=$ws | .pane=$pane | .phase="created"'
  PHASE=created
fi
verify_worktree
verify_workspace
if [[ $PHASE == created ]]; then
  # Linked worktrees share the repository exclude. Serialize this small edit across Crew homes.
  gitdir=$(common_dir "$PROJECT")
  mkdir -p "$gitdir/info"
  lock "$gitdir/info/crew-exclude.lock"
  touch "$gitdir/info/exclude"
  if ! grep -Fxq '/.crew/' "$gitdir/info/exclude"; then printf '\n/.crew/\n' >> "$gitdir/info/exclude"; fi
  unlock "$gitdir/info/crew-exclude.lock"
  [[ ! -L $WORKTREE/.crew ]] || die '.crew must not be a symlink.'
  mkdir -p "$WORKTREE/.crew/answers"
  cp "$CREW_ROOT/WORKER.md" "$WORKTREE/.crew/WORKER.md"
  cp "$STATE/$ID.brief.md" "$WORKTREE/.crew/brief.md"
  cp "$CREW_ROOT/lib/crew-status" "$WORKTREE/.crew/crew-status"
  cp "$CREW_ROOT/lib/crew-usage" "$WORKTREE/.crew/crew-usage"
  chmod +x "$WORKTREE/.crew/crew-status" "$WORKTREE/.crew/crew-usage"
  # Sidecar so crew-usage can fill harness/model/effort without re-parsing launch args.
  jq '{id,kind,harness,model,effort,profile,base,pr_base,share}' "$META" > "$WORKTREE/.crew/task-meta.json"
  touch "$WORKTREE/.crew/status"
  share=$(jq -r '.share // empty' "$META")
  playtest_dir=
  if [[ -n $share ]]; then
    share_root=$STATE/share/$share
    playtest_dir=$STATE/playtest/$share
    mkdir -p "$share_root/updates" "$share_root/reviews" "$playtest_dir"
    if [[ ! -f $share_root/README.md ]]; then
      cp "$CREW_ROOT/lib/share-readme.md" "$share_root/README.md"
    fi
    # Absolute symlink so every worktree sees the same Crew-home board.
    ln -sfn "$share_root" "$WORKTREE/.crew/share"
  fi
  port=$(jq -r .port_base "$META")
  # A disk copy lets a harness recover the values if its tool environment filters them.
  # CHROME_DEVTOOLS_AXI_SESSION isolates this task's browser bridge so teardown can stop it.
  if [[ -n $playtest_dir ]]; then
    playtest_export=$(printf '%q' "$playtest_dir")
    printf 'export PORT=%s\nexport CREW_PORT_BASE=%s\nexport CHROME_DEVTOOLS_AXI_SESSION=%s\nexport PLAYTEST_DIR=%s\n' \
      "$port" "$port" "$ID" "$playtest_export" > "$WORKTREE/.crew/env"
  else
    printf 'export PORT=%s\nexport CREW_PORT_BASE=%s\nexport CHROME_DEVTOOLS_AXI_SESSION=%s\n' \
      "$port" "$port" "$ID" > "$WORKTREE/.crew/env"
  fi
  printf '\nCrew assignment: %s (%s). Branch: %s.\nUse PORT=%s and CREW_PORT_BASE=%s. If absent from tool shells, source .crew/env.\nBrowser checks: CHROME_DEVTOOLS_AXI_SESSION=%s is preset; prefer chrome-devtools-axi on PORT. Teardown stops this session and frees the port block.\nUsage: before done, write .crew/usage.json via .crew/crew-usage (input/output/cached tokens, cost if known, PR url for ships). Teardown refuses tasks without valid usage metrics. See docs/usage-schema.md.\n' \
    "$ID" "$KIND" "$BRANCH" "$port" "$port" "$ID" >> "$WORKTREE/.crew/brief.md"
  phase prepared
fi
if [[ $PHASE == prepared ]]; then
  port=$(jq -r .port_base "$META")
  share=$(jq -r '.share // empty' "$META")
  pane_exports="export PORT=$port CREW_PORT_BASE=$port CHROME_DEVTOOLS_AXI_SESSION=$ID"
  if [[ -n $share ]]; then
    playtest_dir=$STATE/playtest/$share
    mkdir -p "$playtest_dir"
    pane_exports="$pane_exports PLAYTEST_DIR=$(printf '%q' "$playtest_dir")"
  fi
  herdr pane run "$PANE" "$pane_exports" >/dev/null
  phase starting
  launch_args=()
  while IFS= read -r arg; do launch_args+=("$arg"); done < <(jq -r "(.launch_args // .permission_args)[]" "$META")
  if ! herdr agent start "$AGENT" --kind "$(jq -r .harness "$META")" --pane "$PANE" -- "${launch_args[@]+${launch_args[@]}}" > "$STATE/$ID.start.json" 2>&1; then
    append_event failed 'blocked or failed at startup; inspect the pane and resume explicitly'
    die "Startup did not complete. Inspect $AGENT and $STATE/$ID.start.json, then bin/spawn --resume $ID."
  fi
  phase ready
fi
if [[ $PHASE == starting || $PHASE == ready ]]; then
  live=$(agent_state)
  [[ $live == idle || $live == done ]] || die "Agent is $live; clear startup in herdr, then retry --resume."
  # Mark before sending: a crash across prompt delivery must never silently duplicate work.
  phase dispatching
  herdr agent prompt "$AGENT" 'Read .crew/WORKER.md and .crew/brief.md, then do the brief.' > "$STATE/$ID.prompt.json" 2>&1 ||
    die "Prompt was not confirmed. Inspect $STATE/$ID.prompt.json and the pane before any retry."
  phase dispatched
  append_event working spawned
fi
printf '%s: %s\nWorkspace: %s; agent: %s; ports: %s-%s\nBoard: %s/bin/status\n' \
  "$ID" "$WORKTREE" "$WORKSPACE" "$AGENT" "$(jq -r .port_base "$META")" \
  "$(($(jq -r .port_base "$META")+9))" "$CREW_ROOT"
printf 'Model: %s; effort: %s; profile: %s\n' \
  "$(jq -r '.model // "native default"' "$META")" \
  "$(jq -r '.effort // "native default"' "$META")" \
  "$(jq -r '.profile // "legacy"' "$META")"
printf 'Base: %s; PR target: %s\n' \
  "$(jq -r '.base' "$META")" \
  "$(jq -r '.pr_base // empty' "$META")"
if jq -e '.share != null and .share != ""' "$META" >/dev/null; then
  printf 'Share: %s (worktree .crew/share -> %s/share/%s)\n' \
    "$(jq -r '.share' "$META")" "$STATE" "$(jq -r '.share' "$META")"
fi
